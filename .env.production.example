# ==============================================================================
# FMS Portal & Admin Platform - Production Environment Variables
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=fms_admin
POSTGRES_PASSWORD=generate-a-strong-password-here
POSTGRES_DB=fms_production
POSTGRES_PORT=5433

# Application Port on Host
APP_PORT=3010

# NextAuth / Auth.js Secret (สุ่มสร้างด้วยคำสั่ง: openssl rand -base64 32)
AUTH_SECRET=generate-a-32-byte-base64-secret-here

# Public Canonical URL
APP_URL=http://localhost:3010

# Auto Seed Initial Data (1 = ทำการ seed ข้อมูลเริ่มต้นและผู้ใช้ admin/sriparat อัตโนมัติ, 0 = ไม่ seed)
AUTO_SEED=1
SEED_ALLOW_PROD=1

# Email Service (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FMS Portal <no-reply@fms.university.ac.th>"

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
