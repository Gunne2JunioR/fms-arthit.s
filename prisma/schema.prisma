// VibeCore Framework Starter Kit. ตารางระดับแพลตฟอร์ม (ไม่มี tenant_id): users, permissions, auth_tokens, login_throttles
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScopeType {
  ALL
  CAMPUS
  ORG_UNIT
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(50)
  nameTh    String   @map("name_th") @db.VarChar(255)
  nameEn    String   @map("name_en") @db.VarChar(255)
  logoUrl   String?  @map("logo_url") @db.VarChar(500)
  /// { palette?: "blue"|"coral"|"pink"|"green"|"purple" }
  settings  Json     @default("{}") @db.JsonB
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  userTenants UserTenant[]
  roles       Role[]
  auditLogs   AuditLog[]
  sampleItems SampleItem[]
  articleCategories ArticleCategory[]
  articles          Article[]
  departments       Department[]
  staffProfiles     StaffProfile[]
  programs          Program[]
  facilityResources FacilityResource[]
  bookingReservations BookingReservation[]
  documentRequests  DocumentRequest[]

  @@map("tenants")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  /// เก็บตัวพิมพ์เล็กเสมอ
  email              String    @unique @db.VarChar(255)
  googleEmail        String?   @unique @map("google_email") @db.VarChar(255)
  passwordHash       String?   @map("password_hash") @db.VarChar(255)
  /// ชื่อที่แสดง
  name               String    @db.VarChar(255)
  imageUrl           String?   @map("image_url") @db.VarChar(500)
  /// credentials | google | microsoft
  provider           String    @default("credentials") @db.VarChar(20)
  providerId         String?   @map("provider_id") @db.VarChar(255)
  allowGoogleLogin   Boolean   @default(true) @map("allow_google_login")
  emailVerified      Boolean   @default(false) @map("email_verified")
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  /// th | en | null (= ตามเบราว์เซอร์/ค่าเริ่มต้น)
  locale             String?   @db.VarChar(5)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz()
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  userTenants UserTenant[]
  authTokens  AuthToken[]
  auditLogs   AuditLog[]   @relation("AuditActor")
  articles    Article[]    @relation("ArticleAuthor")
  staffProfile          StaffProfile?
  bookingReservations   BookingReservation[]
  documentRequests      DocumentRequest[]
  documentApprovalSteps DocumentApprovalStep[]

  @@map("users")
}

model UserTenant {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  isActive Boolean  @default(true) @map("is_active")
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz()

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("user_tenants")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// A-Z 0-9 _ เช่น SUPER_ADMIN
  code        String   @db.VarChar(50)
  nameTh      String   @map("name_th") @db.VarChar(100)
  nameEn      String   @map("name_en") @db.VarChar(100)
  description String?  @db.VarChar(500)
  /// แก้สิทธิ์/ลบไม่ได้ · SUPER_ADMIN ได้ทุกสิทธิ์โดยไม่ต้องมีแถวใน role_permissions
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, code])
  @@map("roles")
}

/// ผู้ใช้มีได้หลายแถว (หลายบทบาท / บทบาทเดียวหลายขอบเขต) · unique ที่มี scope_id null ไม่กันซ้ำใน Postgres — service ต้องเขียนแบบลบทั้งชุดแล้วสร้างใหม่
model UserRole {
  id           String    @id @default(uuid()) @db.Uuid
  userTenantId String    @map("user_tenant_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  scopeType    ScopeType @default(ALL) @map("scope_type")
  /// campus_id หรือ org_unit_id หรือขอบเขตอื่นที่กำหนดเพิ่ม — null เมื่อ scope_type = ALL
  scopeId      String?   @map("scope_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  userTenant UserTenant @relation(fields: [userTenantId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userTenantId, roleId, scopeType, scopeId])
  @@index([roleId])
  @@map("user_roles")
}

/// seed จาก src/permissions.ts ทุกครั้ง ไม่แก้ผ่าน UI
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(100)
  module      String  @db.VarChar(50)
  action      String  @db.VarChar(50)
  description String? @db.VarChar(255)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// โทเคนใช้ครั้งเดียว — เก็บ sha256 ของโทเคน ไม่เก็บตัวจริง
model AuthToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash") @db.VarChar(128)
  /// EMAIL_VERIFY: { newEmail }
  payload   Json?        @db.JsonB
  expiresAt DateTime     @map("expires_at") @db.Timestamptz()
  usedAt    DateTime?    @map("used_at") @db.Timestamptz()
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

/// กันเดารหัสผ่าน แทน Redis · key = "email:<lower>" หรือ "ip:<addr>"
model LoginThrottle {
  key         String    @id @db.VarChar(320)
  failCount   Int       @default(0) @map("fail_count")
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("login_throttles")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  /// เช่น user.create, user.suspend, role.update
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(50)
  entityId  String   @map("entity_id") @db.VarChar(64)
  before    Json?    @db.JsonB
  after     Json?    @db.JsonB
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

/// โมเดลตัวอย่าง (Sample CRUD) สำหรับให้นักเรียนดูเป็นแม่แบบในการพัฒนาฟีเจอร์ใหม่
model SampleItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  title       String   @db.VarChar(255)
  description String?  @db.Text
  status      String   @default("ACTIVE") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("sample_items")
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ArticleCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nameTh    String   @map("name_th") @db.VarChar(100)
  nameEn    String   @map("name_en") @db.VarChar(100)
  slug      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  articles Article[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("article_categories")
}

model Article {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  categoryId    String        @map("category_id") @db.Uuid
  authorId      String        @map("author_id") @db.Uuid
  title         String        @db.VarChar(255)
  slug          String        @db.VarChar(255)
  excerpt       String?       @db.Text
  content       String        @db.Text
  coverImageUrl String?       @map("cover_image_url") @db.VarChar(500)
  status        ArticleStatus @default(DRAFT)
  isPinned      Boolean       @default(false) @map("is_pinned")
  viewCount     Int           @default(0) @map("view_count")
  publishedAt   DateTime?     @map("published_at") @db.Timestamptz()
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category ArticleCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author   User            @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([tenantId, slug])
  @@index([tenantId, status, publishedAt])
  @@index([tenantId, isPinned])
  @@map("articles")
}

// ── 2. ระบบจัดการบุคลากร (Staff Directory) ──────────────────────────────────
enum StaffStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
}

enum PersonnelType {
  EXECUTIVE
  ACADEMIC
  SUPPORT
  CONTRACT
  OTHER
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE_STUDY
  ON_LEAVE_SICK
  RETIRED
  TERMINATED
  ARCHIVED
}

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String   @db.VarChar(50)
  nameTh      String   @map("name_th") @db.VarChar(255)
  nameEn      String   @map("name_en") @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffProfiles StaffProfile[]
  programs      Program[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("departments")
}

model StaffProfile {
  id                  String            @id @default(uuid()) @db.Uuid
  tenantId            String            @map("tenant_id") @db.Uuid
  departmentId        String            @map("department_id") @db.Uuid
  userId              String?           @unique @map("user_id") @db.Uuid
  personnelCode       String?           @map("personnel_code") @db.VarChar(50)
  prefix              String?           @db.VarChar(50)
  academicTitleTh     String            @default("") @map("academic_title_th") @db.VarChar(50)
  academicTitleEn     String            @default("") @map("academic_title_en") @db.VarChar(50)
  firstNameTh         String            @map("first_name_th") @db.VarChar(100)
  firstNameEn         String            @map("first_name_en") @db.VarChar(100)
  lastNameTh          String            @map("last_name_th") @db.VarChar(100)
  lastNameEn          String            @map("last_name_en") @db.VarChar(100)
  gender              String?           @db.VarChar(20)
  birthDate           DateTime?         @map("birth_date") @db.Date
  citizenIdEncrypted  String?           @map("citizen_id_encrypted") @db.VarChar(255)
  personnelType       PersonnelType     @default(ACADEMIC) @map("personnel_type")
  employmentStatus    EmploymentStatus  @default(ACTIVE) @map("employment_status")
  subDepartmentName   String?           @map("sub_department_name") @db.VarChar(255)
  positionName        String?           @map("position_name") @db.VarChar(100)
  positionTh          String?           @map("position_th") @db.VarChar(100)
  positionEn          String?           @map("position_en") @db.VarChar(100)
  academicPosition    String?           @map("academic_position") @db.VarChar(100)
  email               String            @db.VarChar(255)
  universityEmail     String?           @map("university_email") @db.VarChar(255)
  personalEmail       String?           @map("personal_email") @db.VarChar(255)
  phoneNumber         String?           @map("phone_number") @db.VarChar(50)
  phoneExt            String?           @map("phone_ext") @db.VarChar(50)
  roomNumber          String?           @map("room_number") @db.VarChar(50)
  workLocation        String?           @map("work_location") @db.VarChar(255)
  startDate           DateTime?         @map("start_date") @db.Date
  endDate             DateTime?         @map("end_date") @db.Date
  retirementDate      DateTime?         @map("retirement_date") @db.Date
  avatarUrl           String?           @map("avatar_url") @db.VarChar(500)
  biography           String?           @db.Text
  expertise           Json              @default("[]") @db.JsonB
  education           Json              @default("[]") @db.JsonB
  sortOrder           Int               @default(0) @map("sort_order")
  status              StaffStatus       @default(ACTIVE)
  archivedAt          DateTime?         @map("archived_at") @db.Timestamptz()
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([tenantId, personnelCode])
  @@index([tenantId, departmentId])
  @@index([tenantId, employmentStatus])
  @@index([tenantId, sortOrder])
  @@map("staff_profiles")
}

// ── 3. ระบบจัดการหลักสูตร (Academic Programs) ───────────────────────────────
enum ProgramDegreeLevel {
  BACHELOR
  MASTER
  DOCTORAL
  DIPLOMA
}

enum ProgramStatus {
  OPEN_ADMISSION
  ACTIVE
  REVISED
  CLOSED
}

model Program {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  departmentId       String?            @map("department_id") @db.Uuid
  code               String             @db.VarChar(50)
  nameTh             String             @map("name_th") @db.VarChar(255)
  nameEn             String             @map("name_en") @db.VarChar(255)
  degreeLevel        ProgramDegreeLevel @default(BACHELOR) @map("degree_level")
  degreeNameTh       String             @map("degree_name_th") @db.VarChar(255)
  degreeNameEn       String             @map("degree_name_en") @db.VarChar(255)
  curriculumYear     Int                @map("curriculum_year")
  totalCredits       Int                @map("total_credits")
  tuitionFeeSemester Decimal            @default(0) @map("tuition_fee_semester") @db.Decimal(10, 2)
  durationYears      Int                @default(4) @map("duration_years")
  brochureFileUrl    String?            @map("brochure_file_url") @db.VarChar(500)
  description        String?            @db.Text
  programStructure   Json               @default("[]") @db.JsonB
  status             ProgramStatus      @default(ACTIVE)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz()

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([tenantId, code])
  @@index([tenantId, degreeLevel])
  @@index([tenantId, departmentId])
  @@map("programs")
}

// ── 4. ระบบจองห้องประชุมและยานพาหนะ (Resource Booking) ──────────────────────
enum FacilityType {
  ROOM
  VEHICLE
}

enum BookingStatus {
  PENDING_APPROVAL
  CONFIRMED
  REJECTED
  CANCELLED
}

model FacilityResource {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  nameTh           String       @map("name_th") @db.VarChar(255)
  nameEn           String       @map("name_en") @db.VarChar(255)
  type             FacilityType @default(ROOM)
  capacity         Int          @default(1)
  location         String       @db.VarChar(255)
  amenities        Json         @default("[]") @db.JsonB
  photoUrl         String?      @map("photo_url") @db.VarChar(500)
  requiresApproval Boolean      @default(true) @map("requires_approval")
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations BookingReservation[]

  @@index([tenantId, type, isActive])
  @@map("facility_resources")
}

model BookingReservation {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  resourceId    String        @map("resource_id") @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  title         String        @db.VarChar(255)
  attendeeCount Int           @default(1) @map("attendee_count")
  startAt       DateTime      @map("start_at") @db.Timestamptz()
  endAt         DateTime      @map("end_at") @db.Timestamptz()
  status        BookingStatus @default(PENDING_APPROVAL)
  note          String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resource FacilityResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, resourceId, startAt, endAt])
  @@index([tenantId, userId])
  @@map("booking_reservations")
}

// ── 5. ระบบบริหารจัดการและอนุมัติเอกสาร (e-Document) ────────────────────────
enum DocumentType {
  MEMO_INTERNAL
  PURCHASE_REQUEST
  LEAVE_REQUEST
  TRAVEL_OFFICIAL
}

enum DocumentUrgency {
  NORMAL
  URGENT
  VERY_URGENT
}

enum DocumentStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum StepApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model DocumentRequest {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  docNumber      String          @map("doc_number") @db.VarChar(100)
  requesterId    String          @map("requester_id") @db.Uuid
  docType        DocumentType    @default(MEMO_INTERNAL) @map("doc_type")
  title          String          @db.VarChar(255)
  description    String?         @db.Text
  urgency        DocumentUrgency @default(NORMAL)
  attachmentUrls Json            @default("[]") @map("attachment_urls") @db.JsonB
  currentStep    Int             @default(1) @map("current_step")
  totalSteps     Int             @default(1) @map("total_steps")
  status         DocumentStatus  @default(DRAFT)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz()

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requester     User                   @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  approvalSteps DocumentApprovalStep[]

  @@unique([tenantId, docNumber])
  @@index([tenantId, requesterId])
  @@index([tenantId, status])
  @@map("document_requests")
}

model DocumentApprovalStep {
  id                String             @id @default(uuid()) @db.Uuid
  documentRequestId String             @map("document_request_id") @db.Uuid
  stepOrder         Int                @map("step_order")
  approverTitle     String             @map("approver_title") @db.VarChar(100)
  approverUserId    String?            @map("approver_user_id") @db.Uuid
  status            StepApprovalStatus @default(PENDING)
  comment           String?            @db.Text
  actedAt           DateTime?          @map("acted_at") @db.Timestamptz()

  documentRequest DocumentRequest @relation(fields: [documentRequestId], references: [id], onDelete: Cascade)
  approverUser    User?           @relation(fields: [approverUserId], references: [id], onDelete: SetNull)

  @@index([documentRequestId, stepOrder])
  @@map("document_approval_steps")
}
